# Copy to .env before running `make up`.

# --- Postgres ---
POSTGRES_USER=canals
POSTGRES_PASSWORD=canals
POSTGRES_DB=canals
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Port exposed on the host; change if 5432 is already taken locally.
POSTGRES_HOST_PORT=5432

# --- Redis (phase 2 geocoding cache; unused in phase 1) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6379

# --- App ---
APP_ENV=local
SQL_ECHO=false
RESERVATION_TTL_SECONDS=900
