# Copy to .env before running `make up`.

# --- Postgres ---
POSTGRES_USER=canals
POSTGRES_PASSWORD=canals
POSTGRES_DB=canals
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Port exposed on the host; change if 5432 is already taken locally.
POSTGRES_HOST_PORT=5432

# --- Test database (db-test service) ---
POSTGRES_TEST_DB=canals_test
POSTGRES_TEST_HOST_PORT=55433

# --- Redis (geocoding cache) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6379

# --- App ---
APP_HOST_PORT=8000
APP_ENV=local
SQL_ECHO=false
RESERVATION_TTL_SECONDS=900
GEOCODE_CACHE_TTL_SECONDS=604800
